{
  "name": "localcontacts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "app": "bash scripts/app/launch.sh",
    "import": "tsx scripts/import.ts",
    "export": "tsx scripts/export.ts",
    "clean:names": "tsx scripts/clean-names.ts",
    "merge:dupes": "tsx scripts/merge-dupes.ts",
    "classify:industry": "tsx scripts/classify-industry.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
